load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "nfpmwrapper_lib",
    srcs = ["main.go"],
    importpath = "github.com/ericnorris/rules_nfpm/go/v2/cmd/nfpmwrapper",
    visibility = ["//visibility:private"],
    deps = [
        "//go/v2/internal/cmd/nfpmwrapper",
        "@com_github_alecthomas_kong//:kong",
    ],
)

go_binary(
    name = "nfpmwrapper",
    embed = [":nfpmwrapper_lib"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "nfmpwrapper_test.accept",
    size = "small",
    srcs = [":nfpmwrapper_test"],
    args = [
        "-accept",
    ],
    tags = ["manual"],
)

filegroup(
    name = "package-contents",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
